---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TechBadge from '../components/TechBadge.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Footer from '../components/Footer.astro';

// Fetch and sort projects
const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);

// Decisiones de ingeniería
const engineeringDecisions = [
  {
    id: "cost_vs_convenience",
    title: "Costo operativo vs. comodidad (AWS Graviton + Serverless)",
    rationale: "Evaluación de infraestructura considerando costo operativo real, consumo de RAM y disponibilidad regional frente a opciones PaaS/VPS. Se optó por una arquitectura serverless-first en Cloudflare Workers para el borde combinada con instancias mínimas AWS Graviton/ARM64 aprovisionadas mediante Terraform y sin IPv4 pública (conectividad IPv6), reduciendo drásticamente la factura cloud y la superficie de exposición."
  },
  {
    id: "security_by_design",
    title: "Seguridad por diseño (OIDC sin secretos estáticos y análisis Trivy)",
    rationale: "Eliminación de credenciales estáticas de larga duración entre GitHub Actions y AWS mediante autenticación OIDC y roles IAM temporales. Integración obligatoria de Trivy en el pipeline para bloqueo de despliegues ante vulnerabilidades críticas (CVEs) en dependencias o capas de contenedores Docker."
  },
  {
    id: "justified_complexity",
    title: "Complejidad justificada (Evaluación deliberada de Redis y CQRS)",
    rationale: "Evaluación técnica de patrones y herramientas según la necesidad real del sistema y no por tendencia. Se pospuso conscientemente la adopción de Redis al determinar que la concurrencia actual no justificaba la sobrecarga de mantenimiento de una capa de caché, aplicando la misma premisa al uso selectivo de CQRS."
  },
  {
    id: "abstraction_depth",
    title: "Profundidad en abstracciones (JPA/Hibernate y Spring Security)",
    rationale: "Comprensión interna del comportamiento de los frameworks en lugar de tratarlos como cajas negras. Auditoría activa de consultas SQL generadas por Hibernate para prevenir problemas de N+1 queries y diseño detallado de la cadena de filtros de seguridad en Spring Security."
  },
  {
    id: "evolutionary_architecture",
    title: "Arquitectura evolutiva sobre sobreingeniería prematura",
    rationale: "Diseño modular con arquitectura hexagonal y límites claros (DDD) que permite evolucionar y escalar componentes de forma independiente sin forzar al sistema desde el día cero a resolver problemas de escala que aún no existen."
  }
];

// Áreas de especialidad técnica
const stackAreas = [
  {
    name: "Desarrollo e infraestructura",
    description: "Backend moderno, ecosistemas tipados y aprovisionamiento reproducible.",
    items: [
      "Java 21", "Spring Boot 4", "Spring Security", "TypeScript", 
      "Angular 21 (Signals)", "React 19", "Arquitectura hexagonal", "REST APIs", 
      "Docker (Multi-arch)", "Terraform", "CI/CD (GitHub Actions, OIDC)", 
      "AWS (EC2 Graviton, ECR, S3, IAM, SSM)", "Cloudflare Workers", "OpenAPI"
    ]
  },
  {
    name: "Datos y persistencia",
    description: "Motores relacionales, migraciones versionadas y patrones de resiliencia.",
    items: [
      "PostgreSQL", "Flyway", "JPA / Hibernate", "Supabase (Auth, RLS)", 
      "Patroni", "etcd", "pgBouncer", "MongoDB"
    ]
  },
  {
    name: "Seguridad y observabilidad",
    description: "Defensa en profundidad, autenticación efímera y telemetría distribuida.",
    items: [
      "Trivy (Vulnerability Scanning)", "JWT / OAuth2", "OIDC (Keyless Cloud)", 
      "Grafana Cloud / Alloy", "Prometheus", "Loki", "Tempo", "Tailscale VPN"
    ]
  },
  {
    name: "Arquitectura y metodología",
    description: "Diseño guiado por el dominio, comunicación desacoplada y disciplina ágil.",
    items: [
      "Domain-Driven Design (DDD)", "Arquitectura hexagonal", "ADR", 
      "Scrum (Scrum Master)", "RabbitMQ (Transactional Outbox)", 
      "Spring Cloud Gateway", "Git (Rebase, Worktrees)"
    ]
  },
  {
    name: "Cloud y sistemas",
    description: "Administración de entornos Linux, redes privadas y computación eficiente.",
    items: [
      "Linux / Bash", "Nginx", "Let's Encrypt", "Cloudflare Tunnels", 
      "AWS Graviton / ARM64", "VPS"
    ]
  }
];
---

<Layout title="Alexander Canon | Software Engineer — Backend & Cloud">
  <Header />
  
  <main class="container">
    <!-- Hero Section -->
    <Hero />

    <!-- Sobre Mí Section -->
    <section class="section about-section" id="sobre-mi">
      <div class="about-grid">
        <div class="about-label font-mono">
          <span>Acerca de mí</span>
        </div>
        <div class="about-content">
          <p>
            Backend & Cloud Developer con experiencia práctica construyendo sistemas e infraestructura de punta a punta. He desarrollado pipelines de CI/CD seguros con GitHub Actions y autenticación OIDC hacia AWS, infraestructura como código con Terraform y arquitecturas serverless-first con Cloudflare Workers. También he diseñado arquitecturas hexagonales en Spring Boot 4, resuelto vulnerabilidades de seguridad en producción y gestionado despliegues sobre máquinas virtuales interconectadas mediante redes privadas con Tailscale.
          </p>
        </div>
      </div>
    </section>

    <!-- Proyectos Section -->
    <section class="section projects-section" id="proyectos">
      <SectionHeading eyebrow="01. PROYECTOS" title="Proyectos y Casos de Estudio" />
      
      <div class="projects-grid">
        {sortedProjects.map((project) => (
          <ProjectCard 
            title={project.data.title}
            tag={project.data.tag}
            summary={project.data.summary}
            stack={project.data.stack}
            slug={project.id}
          />
        ))}
      </div>
    </section>

    <!-- Decisiones de Ingeniería Section -->
    <section class="section decisions-section" id="decisiones">
      <SectionHeading eyebrow="02. CRITERIO TÉCNICO" title="Decisiones de Ingeniería & Trade-offs" />
      
      <div class="decisions-grid">
        {engineeringDecisions.map((decision, index) => (
          <article class="decision-card">
            <div class="decision-header">
              <span class="decision-num font-mono">0{index + 1}.</span>
              <h3 class="decision-title">{decision.title}</h3>
            </div>
            <p class="decision-rationale">{decision.rationale}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Stack Section -->
    <section class="section stack-section" id="stack">
      <SectionHeading eyebrow="03. STACK" title="Tecnologías & Herramientas por Especialidad" />
      
      <div class="stack-grid">
        {stackAreas.map((area) => (
          <div class="stack-group">
            <div class="group-header">
              <span class="group-indicator solid"></span>
              <h3 class="font-mono">{area.name.toUpperCase()}</h3>
            </div>
            <p class="group-description">{area.description}</p>
            <div class="badges-wrapper">
              {area.items.map((tech) => (
                <TechBadge name={tech} variant="solid" />
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Contacto Section -->
    <section class="section contact-section" id="contacto">
      <div class="contact-box">
        <span class="contact-eyebrow font-mono">04. CONTACTO</span>
        <h2 class="contact-title">¿Trabajamos en equipo?</h2>
        <p class="contact-text">
          Estoy en disposición para colaborar en oportunidades profesionales, proyectos de ingeniería o desarrollo backend y cloud. Si tienes un reto técnico, un proyecto o deseas intercambiar ideas sobre arquitectura de software, será un gusto conversar.
        </p>
        
        <div class="contact-details font-mono">
          <div class="detail-item">
            <span class="label">Email:</span>
            <a href="mailto:hola@alexandercanon.com" class="value link">hola@alexandercanon.com</a>
          </div>
          <div class="detail-item">
            <span class="label">Ubicación:</span>
            <span class="value">Guatemala — Remoto</span>
          </div>
        </div>

        <div class="contact-actions">
          <a href="mailto:hola@alexandercanon.com" class="btn-primary-action">
            Enviar correo
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* About Section Styles */
  .about-section {
    border-bottom: 1px solid var(--border-subtle);
    padding: 4rem 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 2rem;
    align-items: start;
  }

  .about-label {
    font-size: var(--fs-small);
    color: var(--text-muted);
    font-weight: 500;
  }

  .about-content p {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* Projects Grid */
  .projects-section {
    border-bottom: 1px solid var(--border-subtle);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  /* Decisions Section Styles */
  .decisions-section {
    border-bottom: 1px solid var(--border-subtle);
  }

  .decisions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .decision-card {
    background-color: rgba(24, 24, 27, 0.4);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .decision-card:hover {
    border-color: var(--border);
    transform: translateY(-2px);
  }

  .decision-header {
    margin-bottom: 1rem;
  }

  .decision-num {
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .decision-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .decision-rationale {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Stack Section Styles */
  .stack-section {
    border-bottom: 1px solid var(--border-subtle);
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .stack-group {
    background-color: rgba(24, 24, 27, 0.4);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 2rem;
    transition: border-color var(--transition-fast);
  }

  .stack-group:hover {
    border-color: var(--border);
  }

  .group-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .group-header h3 {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .group-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .group-indicator.solid {
    background-color: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .group-description {
    font-size: var(--fs-small);
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .badges-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Contact Section Styles */
  .contact-box {
    background-color: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 4rem 3rem;
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .contact-eyebrow {
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 1rem;
  }

  .contact-title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
  }

  .contact-text {
    font-size: var(--fs-body);
    color: var(--text-secondary);
    max-width: 480px;
    margin: 0 auto 2.5rem auto;
    line-height: 1.6;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 3rem;
    font-size: 0.875rem;
  }

  .detail-item {
    display: flex;
    gap: 0.5rem;
  }

  .detail-item .label {
    color: var(--text-muted);
  }

  .detail-item .value {
    color: var(--text-primary);
  }

  .detail-item .value.link {
    transition: color var(--transition-fast);
  }

  .detail-item .value.link:hover {
    color: var(--accent);
  }

  .btn-primary-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--accent);
    color: var(--accent-text-on);
    font-weight: 600;
    font-size: 0.875rem;
    padding: 0.875rem 1.75rem;
    border-radius: 4px;
    transition: all var(--transition-fast);
  }

  .btn-primary-action:hover {
    background-color: #5ec5d6;
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(79, 179, 196, 0.2);
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    
    .stack-grid,
    .decisions-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    
    .stack-group,
    .decision-card {
      padding: 1.5rem;
    }

    .contact-box {
      padding: 3rem 1.5rem;
    }
  }
</style>
